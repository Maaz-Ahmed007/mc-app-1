datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Section {
  id          String    @id @default(cuid()) @map("_id")
  sectionName String    @unique

  telephone   String?
  mobileWazir String?
  mobileDin   String?
  email       String?
  password    String    @default("0000")

  partyPayments         PartyPayment[]
  cancelledPayments     PartyCancelledPayment[]
  sales                 Sale[]
  expenses              Expense[]
  labors                Labor[]
}

model Party {
  id        String          @id @default(cuid()) @map("_id")
  name      String          @unique

  payments                  PartyPayment[]
  cancelledPayments         PartyCancelledPayment[]
  sales                     Sale[]
  
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model PartyPayment {
  id        String   @id @default(cuid()) @map("_id")
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id])
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  date      DateTime
  amount    Float
  details   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PartyCancelledPayment {
  id        String   @id @default(cuid()) @map("_id")
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id])
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  date      DateTime
  amount    Float
  details   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id          String   @id @default(cuid()) @map("_id")
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id])
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id])
  date        DateTime
  truckNumber String
  truckWeight Float
  rate        Int
  total       Int
  balance     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id        String           @id @default(cuid()) @map("_id")
  name      String
  sectionId String
  section   Section          @relation(fields: [sectionId], references: [id])
  payments  ExpensePayment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([name, sectionId])
}

model ExpensePayment {
  id        String   @id @default(cuid()) @map("_id")
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id])
  date      DateTime
  amount    Float
  details   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Labor {
  id        String         @id @default(cuid()) @map("_id")
  name      String
  sectionId String
  section   Section        @relation(fields: [sectionId], references: [id])
  payments  LaborPayment[]
  bills     LaborBill[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([name, sectionId])
}

model LaborPayment {
  id        String   @id @default(cuid()) @map("_id")
  laborId   String
  labor     Labor    @relation(fields: [laborId], references: [id])
  date      DateTime
  amount    Float
  details   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LaborBill {
  id        String   @id @default(cuid()) @map("_id")
  laborId   String
  labor     Labor    @relation(fields: [laborId], references: [id])
  date      DateTime
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
